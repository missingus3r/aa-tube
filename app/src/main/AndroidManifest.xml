<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android Auto solo admite apps "para usar estacionado" de la categoría juego, y es el único
         tipo de app de auto que acepta instalada fuera de Play (con "Fuentes desconocidas"). -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:label="AA Tube"
        android:icon="@drawable/ic_app"
        android:appCategory="game"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla del auto. Tarea propia para no mezclarse con la del teléfono, y sin recrearse
             ante cambios de pantalla (soltaría la sesión de Gecko). -->
        <activity
            android:name=".car.CarActivity"
            android:exported="true"
            android:label="AA Tube"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.missingus3r.aatube.car"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".media.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
